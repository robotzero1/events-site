<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         defaultTestSuite="site"
         failOnWarning="true"
         failOnRisky="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <!-- Against answers saved from the API: what runs on every push. -->
        <testsuite name="site">
            <directory>tests</directory>
            <exclude>tests/Real</exclude>
        </testsuite>
        <!-- Against the real API, started locally by bin/with-local-api.php: see README.md. -->
        <testsuite name="real">
            <directory>tests/Real</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
            <directory>standalone/src</directory>
        </include>
    </source>
</phpunit>
