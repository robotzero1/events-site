<!doctype html>
<html lang="{{ language.value }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% for stylesheet in stylesheets %}
  <link rel="stylesheet" href="{{ stylesheet }}">
  {% endfor %}
  {% for script in scripts %}
  <script src="{{ script }}" defer></script>
  {% endfor %}
  <title>{{ answer.page == 'home' ? t('site.name') : answer.title ~ ' · ' ~ t('site.name') }}</title>
  {% if answer.description %}
  <meta name="description" content="{{ answer.description }}">
  {% endif %}
  {% if not answer.indexed %}
  <meta name="robots" content="noindex">
  {% endif %}
  {% if answer.alternates is not empty %}
  <link rel="canonical" href="{{ site_url ~ answer.alternates[language.value] }}">
  {% for code, path in answer.alternates %}
  <link rel="alternate" hreflang="{{ code }}" href="{{ site_url ~ path }}">
  {% endfor %}
  <link rel="alternate" hreflang="x-default" href="{{ site_url }}/">
  {% endif %}
  {# What a link's preview shows, on every page. #}
  <meta property="og:site_name" content="{{ t('site.name') }}">
  <meta property="og:title" content="{{ answer.title }}">
  {% if answer.description %}<meta property="og:description" content="{{ answer.description }}">{% endif %}
  <meta property="og:type" content="website">
  <meta property="og:locale" content="{{ language.value == 'es' ? 'es_ES' : 'en_GB' }}">
  <meta property="og:locale:alternate" content="{{ language.value == 'es' ? 'en_GB' : 'es_ES' }}">
  {% if answer.alternates is not empty %}<meta property="og:url" content="{{ site_url ~ answer.alternates[language.value] }}">{% endif %}
  {% if answer.image %}
  <meta property="og:image" content="{{ answer.image }}">
  <meta name="twitter:card" content="summary_large_image">
  {% else %}
  <meta name="twitter:card" content="summary">
  {% endif %}
  {% if structured %}
  {# Made by the core and written as JSON with every < escaped, so nothing in it can close this script. #}
  <script type="application/ld+json">{{ structured|raw }}</script>
  {% endif %}
</head>
<body>
<div class="events-site">
  <a class="skip" href="#content">{{ t('nav.skip') }}</a>
  <header class="site-head">
    <div class="wrap">
      <a class="brand" href="{{ path('home') }}">{{ t('site.name') }}</a>
      <nav class="nav" aria-label="{{ t('nav.label') }}">
        <a href="{{ path('events') }}"{% if answer.page == 'events' %} aria-current="page"{% endif %}>{{ t('nav.events') }}</a>
        <a href="{{ path('suggest') }}"{% if answer.page == 'suggest' %} aria-current="page"{% endif %}>{{ t('nav.suggest') }}</a>
      </nav>
      <p class="lang">
        {# The same page in the other language, or its front page when this is no page (not found). #}
        <a href="{{ other ?? ('/' ~ language.other.value ~ '/') }}" lang="{{ language.other.value }}" hreflang="{{ language.other.value }}">{{ t('nav.other') }}</a>
      </p>
    </div>
  </header>

  <main class="wrap" id="content">
    {# The page's content, already made by its own template, which escaped everything it was given. #}
    {{ answer.content|raw }}
  </main>

  <footer class="site-foot">
    <div class="wrap">
      <a href="{{ path('about') }}">{{ t('nav.about') }}</a>
      <a href="{{ path('suggest') }}">{{ t('nav.suggest') }}</a>
      <span>{{ t('foot.checked') }}</span>
    </div>
  </footer>
</div>
</body>
</html>
